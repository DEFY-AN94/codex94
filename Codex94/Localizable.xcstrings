    },
    "usage.interval.reportedOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average and peak use reported days only. Missing days are not counted as zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日均值和峰值仅使用已报告日期；缺失日期不计为零。"
          }
        }
      }
    },
    "usage.comparison.range %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous interval: %@ – %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前一等长区间：%@ – %@"
          }
        }
      }
    },
    "usage.comparison.change %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reported total change: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已报告总量变化：%@"
