    "claude.sources.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex94 shows one report at a time. Claude Code's own usage cache is the primary source, the status-line connection fills in when it is newer, and the optional CLI read is the last option. Sources are never merged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex94 每次只显示一份报告。Claude Code 自己的用量缓存是主来源，状态栏连接在更新时补位，可选的 CLI 读取是最后选项。来源之间不会合并计算。"
          }
        }
      }
    },
    "claude.sources.current %@": {
      "extractionState": "manual",
      "localizations": {
