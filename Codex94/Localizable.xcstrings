    "claude.setup.forgetHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Codex94’s old installation record will be removed. Your current status-line command and backup files stay unchanged. You can then preview a new connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除 Codex94 的旧安装记录，不修改当前状态栏命令，也不删除备份文件。完成后可重新预览安装连接。"
          }
        }
      }
    },
    "claude.setup.forgetFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old record could not be released safely. If your current status line still calls the Codex94 bridge, first restore or remove that configuration in Claude Code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全解除旧记录。如果当前状态栏仍调用 Codex94 桥接程序，请先在 Claude Code 设置中恢复或移除该配置。"
          }
        }
      }
    },
    "claude.setup.recordForgotten": {
      "localizations": {
        "en": {
