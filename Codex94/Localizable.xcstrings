    "usage.custom.sourceDates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates use the service’s calendar-day labels. Dates without returned records remain unreported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期沿用服务返回的日历日期；没有记录的日期仍视为未报告。"
          }
        }
      }
    },
    "usage.interval.average": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reported daily average"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已报告日均用量"
          }
        }
      }
    },
    "usage.interval.peak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected-interval peak"
          }
        },
        "zh-Hans": {
