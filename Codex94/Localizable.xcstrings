    "claude.passive.adoptHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the pending local report shown in Services? Its account remains unverified, and it may replace the selected values. Expired reports cannot be adopted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用服务设置中显示的待确认本地报告？其账号身份仍未验证，当前数值可能被替换。已过期的报告不能采用。"
          }
        }
      }
    },
    "claude.passive.adoptAction": {
      "extractionState": "manual",
