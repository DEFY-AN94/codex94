    "usage.comparison.invalidRange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison unavailable for this date range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日期区间暂无法比较。"
          }
        }
