    "claude.passive.codeRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passive data comes from Claude Code on this Mac: its usage cache or the status-line connection. Claude chat apps and the website do not report quota here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被动数据来自本机的 Claude Code：它的用量缓存或状态栏连接。Claude 聊天 App 和网页不会在此上报额度。"
          }
        }
      }
    },
