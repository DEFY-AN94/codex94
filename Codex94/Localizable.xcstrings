    "claude.cliUsage.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow CLI queries during regular refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许常规刷新使用 CLI"
          }
        }
      }
    },
    "claude.cliUsage.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When enabled, scheduled and regular refreshes can start Claude Code. When disabled, these refreshes only reread local files. The one-time button below is separate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后，定时和常规刷新可启动 Claude Code；关闭后，这些刷新只重读本地文件。下方单次按钮独立生效。"
          }
        }
      }
    },
    "claude.cliUsage.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This method starts Claude Code and may consume additional Tokens and subscription quota, including five-hour and weekly quota. Enable only when needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此方式会启动 Claude Code，可能额外消耗 Token 和订阅额度，包括五小时及每周额度。请按需开启。"
          }
        }
      }
    },
    "claude.setup.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude status-line settings changed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 状态栏设置已更改"
          }
        }
      }
    },
    "claude.setup.conflictHelp": {
      "localizations": {
        "en": {
