    },
    "updates.manualOnly" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checks GitHub only when you click. Download and install updates manually from the release page. No background checks or automatic installation." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在点击时检查 GitHub；请从发布页面手动下载安装，不会后台检查或自动安装。" } }
      }
    },
    "updates.upToDate" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No newer published stable version is available." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目前没有更新的已发布正式版本。" } }
      }
    },
    "updates.available" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A newer stable version is available" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有新的正式版本可用" } }
      }
