      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last report has no quota windows left; waiting for Claude Code to fetch usage again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次报告的额度窗口均已到期，等待 Claude Code 再次获取用量。"
          }
        }
      }
    },
    "claude.passive.confirmationRequired": {
      "extractionState": "manual",
      "localizations": {
