    "claude.localCache.absent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Claude Code usage cache on this Mac yet. Run claude in a terminal and enter /usage, or use the one-time CLI read in Services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机还没有 Claude Code 的用量缓存。请在终端运行 claude 并输入 /usage，或在服务设置里使用一次 CLI 读取。"
          }
        }
      }
    },
