    "claude.localCacheTime.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is when Claude Code fetched the data, not when Codex94 reread the local file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 Claude Code 获取数据的时间，不是 Codex94 重读本地文件的时间。"
          }
        }
      }
    },
    "claude.cliUsage.regularRefresh.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular refresh is allowed to start Claude Code. It may consume Tokens and five-hour or weekly subscription quota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许常规刷新启动 Claude Code，可能消耗 Token 和五小时、每周订阅额度。"
          }
        }
      }
    },
    "claude.passive.reread.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereads local quota files without fetching cloud usage. If there is no new report, the report time stays unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只重读本地额度文件，不查询云端用量；没有新报告时，报告时间保持不变。"
          }
        }
      }
    },
    "claude.cliUsage.readOnce.noData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CLI read returned only windows that had already reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 读取只返回了已到期的窗口。"
          }
        }
      }
    },
