    "claude.passive.accountHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local reports do not verify account identity; a session identifier is not account proof. A different source will not replace the selected report automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地报告无法验证账号身份，会话标识也不是账号证明。不同来源不会自动替换已选报告。"
          }
        }
      }
    },
    "claude.passive.pending": {
      "extractionState": "manual",
      "localizations": {
