    "claude.cliUsage.readOnce": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Claude Code for one query"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动 Claude Code 读取一次"
          }
        }
      }
    },
    "claude.cliUsage.readOnce.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This explicit action starts Claude Code once even when regular CLI queries are disabled. It does not enable regular queries and may consume Tokens and five-hour or weekly subscription quota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使常规 CLI 查询关闭，此操作仍会启动一次 Claude Code，不会开启常规查询；可能消耗 Token 和五小时、每周订阅额度。"
          }
        }
      }
    },
    "claude.cliUsage.lastRead %@": {
