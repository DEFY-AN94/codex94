    "providers.menuBar.compactBoth.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex is on the left and Claude on the right. Hover for each quota and reset time. With one service enabled, its usual layout is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧是 Codex，右侧是 Claude；悬停查看各自额度与重置时间。仅启用一个服务时使用原有布局。"
          }
        }
      }
    },
