    "usage.comparison.incompleteCurrent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison unavailable: the selected interval has unreported days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无法比较：所选区间存在未报告日期。"
          }
        }
      }
    },
    "usage.comparison.incompletePrevious": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison unavailable: the previous interval has unreported days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无法比较：前一区间存在未报告日期。"
          }
        }
      }
    },
    "usage.comparison.zeroBaseline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No percentage change: the previous interval totals zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前一区间总量为零，不计算增长百分比。"
          }
        }
      }
    },
    "usage.comparison.overflow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison unavailable: a reported total exceeds the supported number range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无法比较：已报告总量超出支持的数值范围。"
